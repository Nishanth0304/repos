@model EmployeeManagementSystem.Models.Employee
<h2>Add Employee</h2>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div>
        <label asp-for="EmployeeId"></label>
        <input asp-for="EmployeeId" />
        <span asp-validation-for="EmployeeId" class="text-danger"></span>
    </div>
    <br />
    <div>
        <label asp-for="EmployeeName"></label>
        <input asp-for="EmployeeName" />
        <span asp-validation-for="EmployeeName" class="text-danger"></span>
    </div>
    <br />
    <div>
        <label asp-for="Department"></label>
        <input asp-for="Department" />
        <span asp-validation-for="Department" class="text-danger"></span>
    </div>
    <br />
    <div>
        <label asp-for="Salary"></label>
        <input asp-for="Salary" />
        <span asp-validation-for="Salary" class="text-danger"></span>
    </div>
    <br />
    <button type="submit">Submit</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
