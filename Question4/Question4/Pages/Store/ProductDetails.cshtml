@page "/Store/ProductDetails/{id:int}"
@model Question4.Pages.Store.ProductDetailsModel

<h2>Product Details</h2>

<dl class="row">
    <dt class="col-sm-2">ProductId</dt>
    <dd class="col-sm-10">@Model.Product?.ProductId</dd>

    <dt class="col-sm-2">ProductName</dt>
    <dd class="col-sm-10">@Model.Product?.ProductName</dd>

    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Product?.Category</dd>

    <dt class="col-sm-2">Price</dt>
    <dd class="col-sm-10">@Model.Product?.Price</dd>

    <dt class="col-sm-2">Quantity</dt>
    <dd class="col-sm-10">@Model.Product?.Quantity</dd>
</dl>

<a class="btn btn-secondary" asp-page="/Store/Products">Back</a>
