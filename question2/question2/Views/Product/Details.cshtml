@{
    ViewData["Title"] = "Product Details";
}

<h2>@ViewData["Title"]</h2>

<table class="table table-bordered">
    <tr>
        <th>Product ID</th>
        <td>@ViewBag.ProductID</td>
    </tr>
    <tr>
        <th>Product Name</th>
        <td>@ViewBag.ProductName</td>
    </tr>
    <tr>
        <th>Price</th>
        <td>@ViewBag.Price</td>
    </tr>
</table>

