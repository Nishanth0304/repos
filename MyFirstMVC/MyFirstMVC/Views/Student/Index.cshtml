@model List<MyFirstMVC.Models.Student>

<h1>Student Details</h1>

<table class="student-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Course</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Course</td>
            </tr>
        }
    </tbody>
</table>

<style>
    .student-table {
        border-collapse: collapse;
    }

    .student-table th,
    .student-table td {
        border: 1px solid black;
        padding: 8px;
    }
</style>