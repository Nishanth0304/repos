@{
}
@model List<EmployeeStoreProcedureMVC.Models.Employee>

<h1>Employee List</h1>

<a asp-action="Create" class="btn btn-primary">Add Employee</a>

<table class="table table-bordered mt-3">

    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Department</th>
            <th>Salary</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.EmployeeId</td>
                <td>@employee.Name</td>
                <td>@employee.Department</td>
                <td>@employee.Salary</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@employee.EmployeeId"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@employee.EmployeeId"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>