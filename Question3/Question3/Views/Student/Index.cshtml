@model IEnumerable<Question3.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>
<p>
    <a asp-action="Create">Add Student</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Course</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.StudentId</td>
            <td>@s.Name</td>
            <td>@s.Course</td>
            <td>@s.Email</td>
        </tr>
    }
    </tbody>
</table>
