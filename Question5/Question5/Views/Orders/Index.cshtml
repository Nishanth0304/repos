@{
}


@model IEnumerable<Question5.Models.Order>

<h2>Orders</h2>

<table border="1">
    <tr>
        <th>Order ID</th>
        <th>Order Date</th>
        <th>User</th>
        <th>Email</th>
        <th>Products</th>
    </tr>

    @foreach (var order in Model)
    {
        <tr>
            <td>@order.OrderId</td>
            <td>@order.OrderDate</td>
            <td>@order.User.Name</td>
            <td>@order.User.Email</td>
            <td>
                @foreach (var product in order.Products)
                {
                    <div>
                        @product.ProductName - @product.Price
                    </div>
                }
            </td>
        </tr>
    }
</table>